# === Domain ===
DOMAIN=support.example.com

# === Database ===
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === Auth ===
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

# === OpenRouter (LLM) ===
OPENROUTER_API_KEY=sk-or-v1-...

# === Admin ===
# API integration key (not used to sign in to the dashboard)
ADMIN_API_KEY=CHANGE_ME_RANDOM_32_CHARS
ADMIN_EMAIL=admin@example.com
# Generate using server/src/modules/admin/admin-password.ts; never store a plain password.
ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH

# === Logging ===
LOG_LEVEL=low
