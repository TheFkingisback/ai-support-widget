# === Domain ===
DOMAIN=support.example.com

# === Database ===
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === Auth ===
# Preserve this old secret while migrating; it may also encrypt stored service tokens.
JWT_SECRET=CHANGE_ME_LEGACY_RANDOM_64_CHARS
# Generate independent random values. Never copy one secret into another field.
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_RANDOM_64_CHARS
WIDGET_JWT_SECRET=CHANGE_ME_WIDGET_RANDOM_64_CHARS
# Optional migration only. Set both, with an explicit UTC deadline within seven days.
LEGACY_WIDGET_TENANTS=
LEGACY_WIDGET_ACCEPT_UNTIL=

# === OpenRouter (LLM) ===
OPENROUTER_API_KEY=sk-or-v1-...

# === Admin ===
# API integration key (not used to sign in to the dashboard)
ADMIN_API_KEY=CHANGE_ME_RANDOM_32_CHARS
ADMIN_EMAIL=admin@example.com
# Generate using server/src/modules/admin/admin-password.ts; never store a plain password.
ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH

# === Logging ===
LOG_LEVEL=low
