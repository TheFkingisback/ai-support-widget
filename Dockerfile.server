FROM node:24-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json ./server/package.json
COPY web/package.json ./web/package.json
COPY widget/package.json ./widget/package.json
COPY shared/package.json ./shared/package.json
RUN npm ci --workspace @ai-support/server --include-workspace-root=false

FROM dependencies AS build
COPY shared ./shared
COPY server/tsconfig.json ./server/tsconfig.json
COPY server/src ./server/src
RUN npm run build --workspace @ai-support/server

FROM dependencies AS production-deps
RUN npm prune --omit=dev --workspace @ai-support/server --include-workspace-root=false

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=production-deps /app/node_modules ./node_modules
COPY --from=production-deps /app/server ./server
COPY --from=build /app/shared ./shared
COPY --from=build /app/server/dist ./server/dist
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
  && mkdir -p /app/server/logs && chown -R appuser:appgroup /app/server
WORKDIR /app/server
USER appuser
EXPOSE 3005
HEALTHCHECK --interval=30s --timeout=8s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3005/api/health || exit 1
CMD ["node", "dist/index.js"]
